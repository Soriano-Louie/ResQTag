# ResQTag Server Configuration

# Server Port (Render injects this dynamically)
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS & Cookie Permissions)
CLIENT_URL=http://localhost:5173

# Hosted frontend for emailed QR links (required even when running locally)
PUBLIC_SITE_URL=https://res-q-tag.vercel.app

# Authentication JWT Secret (Change in production)
JWT_SECRET=resqtag_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=7d

# ----------------------------------------------------
# DATABASE CONFIGURATION
# Option A: Aiven / Cloud MySQL URI (Recommended for Render + Aiven)
# ----------------------------------------------------
DATABASE_URL=mysql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_AIVEN_HOST.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED

# ----------------------------------------------------
# Option B: Discrete Parameters (Local MySQL / Standard)
# ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqtag_db
DB_SSL=false

# ----------------------------------------------------
# BREVO TRANSACTIONAL EMAIL SERVICE
# ----------------------------------------------------
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=support@yourdomain.com
BREVO_SENDER_NAME=ResQTag Emergency System

# ----------------------------------------------------
# CLOUDINARY PERMANENT RECEIPT STORAGE (For Render)
# ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


